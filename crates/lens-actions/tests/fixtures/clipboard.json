{
  "id": "arcade.clipboard",
  "name": "Arcade Clipboard",
  "version": "0.0.0-mock",
  "actions": [
    { "id": "clipboard.add", "title": "Send to my devices", "verb": "send", "accepts": ["text/*", "file/image", "file/any[]"],
      "effects": ["sends-to-device"], "maxBytes": 16777216 },
    { "id": "clipboard.pick", "title": "Choose from clipboard history", "verb": "pick", "interactive": true,
      "produces": ["text/*", "file/*"], "effects": ["opens-ui"],
      "mock": { "result": { "outputs": [{ "type": "text/plain", "text": "picked clip" }] } } },
    { "id": "clipboard.devices", "title": "My devices", "verb": "list", "produces": ["structured/devices"],
      "mock": { "result": { "outputs": [{ "type": "structured/devices", "data": [{ "name": "Phone", "platform": "ios", "online": true }] }] } } }
  ],
  "menu": [{"id": "private", "title": "Private mode", "kind": "toggle", "enabled": true, "checked": false}, {"id": "pause", "title": "Pause sync", "kind": "toggle", "enabled": true, "checked": false}],
  "docs": {"version": "0.0.0-mock"},
  "methods": ["app.settings", "app.restart", "app.menu", "app.menu.invoke", "app.shortcuts.set", "app.settings.export", "app.settings.import"]
}
