[Desktop Entry]
Type=Application
Name=Arcade Lens
GenericName=Screen Lens
Comment=Select anything on screen and act on it.
Exec=arcade-lens
Icon=dev.arcade.Lens
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;capture;ocr;text;qr;color;pin;annotate;lens;
StartupNotify=false
StartupWMClass=dev.arcade.Lens
Actions=Capture;Settings;Quit;

[Desktop Action Capture]
Name=Capture
Exec=arcade-lens --capture

[Desktop Action Settings]
Name=Settings
Exec=arcade-lens --settings

[Desktop Action Quit]
Name=Quit Arcade Lens
Exec=arcade-lens --quit
