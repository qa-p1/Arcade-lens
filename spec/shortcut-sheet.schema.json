{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "checkedVersion",
    "sources",
    "match",
    "groups"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "checkedVersion": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://[^/\\s]+[^\\s]*$"
      },
      "uniqueItems": true
    },
    "match": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "linux"
          ]
        },
        {
          "required": [
            "windows"
          ]
        },
        {
          "required": [
            "macos"
          ]
        }
      ],
      "properties": {
        "linux": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "windows": {
          "type": "object",
          "required": [
            "exe"
          ],
          "properties": {
            "exe": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "macos": {
          "type": "object",
          "required": [
            "bundle"
          ],
          "properties": {
            "bundle": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "title",
        "context",
        "shortcuts"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "shortcuts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shortcut"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "context": {
                "const": "global"
              }
            }
          },
          "else": {
            "properties": {
              "shortcuts": {
                "items": {
                  "properties": {
                    "rebindable": false
                  }
                }
              }
            }
          }
        }
      ]
    },
