  "$comment": "Global context is reserved for windows-system and macos-system. Semantic validation checks unique IDs, conflicting alternatives and context/OS prefix conflicts.",
  "$id": "https://github.com/qa-p1/Arcade-link/spec/shortcut-sheet.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "enum": [
              "windows-system",
              "macos-system"
            ]
