    {
      "name": "app-os-overrides-and-alternatives",
      "document": {
        "schema": 1,
        "app": "arcade.find",
        "version": "0.3.0",
        "groups": [
          {
            "title": "Global",
            "context": "global",
            "shortcuts": [
              {
                "id": "toggle",
                "title": "Show or hide Find",
                "keys": {
                  "default": "Ctrl+Alt+F"
                },
                "rebindable": true
              }
            ]
          },
          {
            "title": "Results",
            "context": "overlay",
            "shortcuts": [
              {
                "id": "open",
                "title": "Open with the default app",
                "keys": {
                  "default": "Shift+Enter"
                }
              },
              {
                "id": "pin",
                "title": "Pin",
                "keys": {
                  "default": "Ctrl+Shift+P",
                  "macos": "Shift+Super+P"
                },
                "description": "Optional longer text."
              },
              {
                "id": "menu",
                "title": "Menu",
                "keys": {
                  "linux": [
                    "Menu",
                    "Shift+F10"
                  ],
                  "windows": null,
                  "macos": "Ctrl+M"
                }
              }
            ]
          }
        ]
      },
      "markdown": "## Global\n\n| Action | Linux | Windows | macOS |\n| --- | --- | --- | --- |\n| Show or hide Find | Ctrl+Alt+F | Ctrl+Alt+F | ⌃⌥F |\n\n## Results\n\n| Action | Linux | Windows | macOS |\n| --- | --- | --- | --- |\n| Open with the default app | Shift+Enter | Shift+Enter | ⇧↩ |\n| Pin | Ctrl+Shift+P | Ctrl+Shift+P | ⇧⌘P |\n| Menu | Menu<br>Shift+F10 | — | ⌃M |\n\n",
      "manifest": {
        "id": "arcade.find",
        "shortcuts": [
          {
            "id": "toggle",
            "accelerator": "Ctrl+Alt+F"
          }
        ]
      }
