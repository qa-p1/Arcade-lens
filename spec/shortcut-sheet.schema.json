                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^(?:(?:Ctrl\\+)?(?:Alt\\+)?(?:Shift\\+)?(?:Super\\+)?(?:Space|Enter|Tab|Escape|Backspace|Delete|Insert|Home|End|PageUp|PageDown|Up|Down|Left|Right|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|Print|Pause|ScrollLock|CapsLock|NumLock|Menu|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|VolumeUp|VolumeDown|VolumeMute|MicMute|MediaPlayPause|MediaNext|MediaPrevious|MediaStop|BrightnessUp|BrightnessDown|MouseLeft|MouseRight|MouseMiddle|MouseBack|MouseForward|WheelUp|WheelDown|WheelLeft|WheelRight|[A-Z]|[0-9]|F(?:[1-9]|1[0-9]|2[0-4])|Numpad[0-9]|Code(?:0|[1-9][0-9]*))|Ctrl|Alt|Shift|Super)(?: (?:(?:Ctrl\\+)?(?:Alt\\+)?(?:Shift\\+)?(?:Super\\+)?(?:Space|Enter|Tab|Escape|Backspace|Delete|Insert|Home|End|PageUp|PageDown|Up|Down|Left|Right|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|Print|Pause|ScrollLock|CapsLock|NumLock|Menu|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|VolumeUp|VolumeDown|VolumeMute|MicMute|MediaPlayPause|MediaNext|MediaPrevious|MediaStop|BrightnessUp|BrightnessDown|MouseLeft|MouseRight|MouseMiddle|MouseBack|MouseForward|WheelUp|WheelDown|WheelLeft|WheelRight|[A-Z]|[0-9]|F(?:[1-9]|1[0-9]|2[0-4])|Numpad[0-9]|Code(?:0|[1-9][0-9]*))|Ctrl|Alt|Shift|Super))*$"
                  },
