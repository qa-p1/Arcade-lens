  "display": [
    {
      "input": "Ctrl+Alt+Shift+Super+P",
      "os": "macos",
      "expected": "⌃⌥⇧⌘P"
    },
    {
      "input": "Shift+Super+P",
      "os": "macos",
      "expected": "⇧⌘P"
    },
    {
      "input": "Ctrl+Alt+Shift+Super+P",
      "os": "windows",
      "expected": "Ctrl+Alt+Shift+Win+P"
    },
    {
      "input": "Ctrl+Alt+Shift+Super+P",
      "os": "linux",
      "expected": "Ctrl+Alt+Shift+Super+P"
    },
    {
      "input": "Super+Slash",
      "os": "linux",
      "expected": "Super+/"
    },
    {
      "input": "Super",
      "os": "macos",
      "expected": "⌘"
    },
    {
      "input": "Ctrl+K Ctrl+S",
      "os": "macos",
      "expected": "⌃K ⌃S"
    },
    {
      "input": "Alt+Up",
      "os": "windows",
      "expected": "Alt+↑"
    },
    {
      "input": "Shift+Enter",
      "os": "macos",
      "expected": "⇧↩"
    },
    {
      "input": "Ctrl+Shift+Equal",
      "os": "linux",
      "expected": "Ctrl+Shift+="
    },
    {
      "input": "MicMute",
      "os": "linux",
      "expected": "MicMute"
    },
    {
      "input": "Ctrl+WheelLeft",
      "os": "windows",
      "expected": "Ctrl+WheelLeft"
    },
    {
      "input": "Alt+WheelRight",
      "os": "macos",
      "expected": "⌥WheelRight"
    }
  ],
  "conflicts": [
    {
      "a": "Ctrl+K",
      "b": "Ctrl+K Ctrl+S",
      "expected": true
    },
    {
      "a": "Ctrl+K Ctrl+S",
      "b": "Ctrl+K",
      "expected": true
    },
    {
      "a": "Ctrl+K Ctrl+S",
      "b": "Ctrl+K Ctrl+C",
      "expected": false
    },
    {
      "a": "alt+ctl+f",
      "b": "Ctrl+Alt+F",
      "expected": true
    },
    {
      "a": "Super",
      "b": "Super+Slash",
      "expected": false
    },
    {
      "a": "Ctrl+K",
      "b": "Ctrl+Shift+K",
      "expected": false
    },
    {
      "a": "SUPER + SUPER_L",
      "b": "Super",
      "expected": true
    },
    {
      "a": "mouse_left",
      "b": "WheelRight",
      "expected": false
    }
  ],
  "invalid": [
